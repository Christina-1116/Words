page { --bg: #F3F4F1; --panel: #FFFFFF; --sunk: #E9EBE6; --ink: #1D2622; --muted: #66706B; --line: #D9DDD6; --accent: #2E6A58; --accent-soft: #DCEAE3; --cinnabar: #B5432F;
  background: var(--bg); color: var(--ink); font-size: 28rpx; line-height: 1.55; font-family: -apple-system, "PingFang SC", sans-serif; }
.serif { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; }
.wrap { padding: 28rpx 32rpx 60rpx; }
.h1 { font-size: 44rpx; font-weight: 600; }
.lead { color: var(--muted); font-size: 26rpx; margin-top: 6rpx; }
.card { background: var(--panel); border: 1rpx solid var(--line); border-radius: 20rpx; padding: 28rpx; margin-top: 24rpx; }
.label { font-size: 24rpx; color: var(--muted); margin-bottom: 12rpx; }
.row { display: flex; flex-wrap: wrap; gap: 14rpx; align-items: center; }
.btn { display: inline-flex; align-items: center; justify-content: center; padding: 14rpx 28rpx; border-radius: 16rpx; border: 1rpx solid var(--line); background: var(--panel); font-size: 28rpx; line-height: 1.3; margin: 0; }
.btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); font-weight: 600; }
.btn.sm { padding: 8rpx 20rpx; font-size: 24rpx; }
.hint { color: var(--muted); font-size: 24rpx; }
.seg { display: inline-flex; background: var(--sunk); border-radius: 14rpx; padding: 6rpx; }
.seg view { padding: 8rpx 22rpx; border-radius: 10rpx; font-size: 26rpx; color: var(--muted); }
.seg .on { background: var(--panel); color: var(--ink); }
input, textarea { border: 1rpx solid var(--line); border-radius: 14rpx; padding: 14rpx 18rpx; background: var(--panel); }
