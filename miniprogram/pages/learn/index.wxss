.head { display: flex; justify-content: space-between; align-items: center; }
.hpy { font-family: var(--f-py); font-weight: 600; font-size: 36rpx; color: var(--persimmon); }
.hzh { font-size: 96rpx; line-height: 1.1; } .curc { color: var(--cinnabar); }
.hen { font-family: var(--f-py); font-style: italic; color: var(--sub); font-size: 28rpx; }
.hemoji { font-size: 128rpx; transform: rotate(8deg); }
.strokes { display: flex; flex-direction: column; gap: 22rpx; }
.grids { display: flex; gap: 20rpx; justify-content: center; }
.g { width: 196rpx; height: 196rpx; }
.g.focus { box-shadow: 0 0 0 6rpx var(--mustard); }
.wc { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 1; }
.steps { display: flex; flex-wrap: wrap; gap: 10rpx; justify-content: center; }
.sb { width: 52rpx; height: 52rpx; border: 3rpx solid var(--ink); border-radius: 12rpx; background: var(--card); display: flex; align-items: center; justify-content: center; font-family: var(--f-py); font-size: 22rpx; color: var(--line); box-sizing: border-box; }
.sb.d { color: var(--ink); background: var(--paper2); } .sb.n { background: var(--persimmon); color: #fff; }
.actions { display: flex; gap: 20rpx; } .actions .btn { flex: 1; }
.col { flex-direction: column; gap: 2rpx; font-size: 30rpx; padding: 16rpx 0; } .ic { font-size: 40rpx; }
.sent { font-size: 36rpx; line-height: 1.9; } .mk { background: var(--mustard); border-radius: 10rpx; padding: 0 6rpx; }
.tipline { display: flex; align-items: center; gap: 24rpx; }
