<nav-bar title="复习"><text class="pill o" wx:if="{{st.due}}">还剩 {{st.due}} 个</text></nav-bar>
<view class="wrap">
  <view class="beads" wx:if="{{beads.length}}"><view wx:for="{{beads}}" wx:key="index" class="bd {{item}}"></view></view>

  <view class="card quiz" wx:if="{{state === 'quiz'}}">
    <view class="pic"><image wx:if="{{card.thumb}}" src="{{card.thumb}}" mode="aspectFill" /><text wx:else class="pe">{{card.emoji}}</text></view>
    <view class="row" style="justify-content: center"><text class="cute q">这是什么？</text><text class="pill" bindtap="hear">🔊</text></view>
    <view class="opts">
      <view wx:for="{{opts}}" wx:key="id" class="opt brush {{marks[item.id]}}" data-id="{{item.id}}" bindtap="answer">{{item.zh}}<view class="op" wx:if="{{marks[item.id] === 'ok'}}">{{item.pinyin}} ✓</view></view>
    </view>
    <view class="hint" wx:if="{{card.scene}}">这张图来自你拍的{{card.scene}}</view>
  </view>
  <view class="card pad done" wx:else>
    <image class="deer" src="/assets/deer.svg" mode="aspectFit" />
    <view>
      <view class="cute" style="font-size: 38rpx">{{state === 'few' ? '先去拍照学几个词吧' : '今天的复习都完成啦！'}}</view>
      <view class="hint">{{state === 'few' ? '至少 2 个词才能出选择题' : '下一个词 ' + nextLabel + '到期'}}</view>
      <view class="btn sm" style="margin-top: 16rpx; display: inline-flex" wx:if="{{state === 'few'}}" bindtap="goSnap">去拍一拍</view>
    </view>
  </view>

  <view class="card pad cal">
    <view class="between"><text class="title">复习日历</text><text class="hint">1 → 2 → 4 → 7 → 15 → 30 天</text></view>
    <view class="cr"><view wx:for="{{days}}" wx:key="d" class="cd"><text class="hint">{{item.w}}</text><view class="cb {{item.cls}}">{{item.d}}</view><text class="cn">{{item.n ? item.n + '个' : ''}}</text></view></view>
  </view>

  <view class="card list" wx:if="{{deck.length}}">
    <view class="between lh" bindtap="toggleList"><text class="title">我的词（{{deck.length}}）· 已掌握 {{st.mastered}}</text><text class="hint">{{showList ? '收起' : '展开'}}</text></view>
    <block wx:if="{{showList}}">
      <view class="it" wx:for="{{deck}}" wx:key="id" data-zh="{{item.zh}}" bindtap="learn">
        <view class="th"><image wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" /><text wx:else>{{item.emoji}}</text></view>
        <view style="flex: 1"><view class="brush iz">{{item.zh}}</view><view class="hint">{{item.pinyin}} · {{item.en}}</view></view>
        <view style="text-align: right"><view class="lv"><view wx:for="{{5}}" wx:for-item="k" wx:key="*this" class="ld {{item.level > k ? 'f' : ''}}"></view></view><view class="hint">{{item.next}}</view></view>
      </view>
    </block>
  </view>
</view>
