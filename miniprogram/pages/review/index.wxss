.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; margin-top: 24rpx; }
.stat { background: var(--panel); border: 1rpx solid var(--line); border-radius: 16rpx; padding: 16rpx; }
.stat .n { font-size: 44rpx; font-weight: 600; font-family: Georgia, serif; }
.stat.hot .n { color: var(--cinnabar); }
.quiz { display: flex; flex-direction: column; align-items: center; gap: 24rpx; text-align: center; }
.pic { width: 320rpx; height: 320rpx; border-radius: 24rpx; overflow: hidden; background: var(--sunk); display: flex; align-items: center; justify-content: center; font-size: 160rpx; }
.pic image { width: 100%; height: 100%; }
.opts { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; width: 100%; }
.opt { border: 2rpx solid var(--line); border-radius: 20rpx; padding: 24rpx 0; font-size: 44rpx; font-weight: 600; }
.opt.right { border-color: #2E7D4F; background: #E3F1E8; }
.opt.wrong { border-color: var(--cinnabar); background: #F7E4E0; }
.it { display: flex; gap: 20rpx; align-items: center; padding: 16rpx 28rpx; border-top: 1rpx solid var(--line); }
.th { width: 80rpx; height: 80rpx; border-radius: 14rpx; overflow: hidden; background: var(--sunk); display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.th image { width: 100%; height: 100%; }
