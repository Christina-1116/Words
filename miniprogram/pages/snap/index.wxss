.photo { position: relative; overflow: hidden; padding: 0; }
.img { width: 100%; height: 100%; display: block; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 50rpx 30rpx; }
.big-deer { width: 220rpx; height: 240rpx; }
.scan { position: absolute; left: 0; right: 0; height: 30%; top: -30%; background: linear-gradient(to bottom, transparent, rgba(232,116,59,.35)); border-bottom: 6rpx solid var(--persimmon); animation: scan 1.4s ease-in-out infinite; }
@keyframes scan { to { top: 100%; } }
/* 贴纸：在物品上方，弹出 + 微倾斜 */
.stk { position: absolute; transform: translate(-50%, -100%) rotate(var(--r)) scale(.4); opacity: 0; background: var(--card); border: 4rpx solid var(--ink); border-radius: 18rpx; padding: 0 12rpx 4rpx; text-align: center; box-shadow: 4rpx 4rpx 0 var(--ink); white-space: nowrap; animation: pop .45s cubic-bezier(.2,1.5,.4,1) forwards; }
.stk.on { background: var(--persimmon); color: #fff; }
.stk-zh { font-size: 30rpx; line-height: 1.2; }
.stk-py { font-family: var(--f-py); font-size: 17rpx; color: var(--sub); }
.stk.on .stk-py { color: #FFE7D6; }
@keyframes pop { to { transform: translate(-50%, -100%) rotate(var(--r)) scale(1); opacity: 1; } }
.pin { position: absolute; width: 36rpx; height: 36rpx; margin: -18rpx 0 0 -18rpx; border-radius: 50%; background: var(--persimmon); border: 4rpx solid var(--ink); }
.found { display: flex; flex-direction: column; gap: 16rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { font-size: 30rpx; }
.manual { display: flex; flex-direction: column; gap: 14rpx; }
.in { flex: 1; border: 4rpx solid var(--ink); border-radius: 22rpx; padding: 12rpx 20rpx; background: var(--card); }
.tipline { display: flex; align-items: center; gap: 24rpx; }
.controls { display: flex; align-items: center; justify-content: space-between; }
.side { width: 200rpx; font-size: 28rpx; padding: 14rpx 0; }
.shutter { width: 136rpx; height: 136rpx; border-radius: 50%; border: 6rpx solid var(--ink); background: var(--persimmon); box-shadow: 6rpx 6rpx 0 var(--ink), inset 0 0 0 10rpx var(--card); display: flex; align-items: center; justify-content: center; font-size: 50rpx; }
.shutter:active { transform: translate(4rpx, 4rpx); box-shadow: 2rpx 2rpx 0 var(--ink), inset 0 0 0 10rpx var(--card); }
.offstage { position: fixed; left: -9999px; top: 0; width: 1200px; height: 900px; }
