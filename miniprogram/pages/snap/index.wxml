<nav-bar title="拍一拍"><text class="pill s" wx:if="{{scene}}">{{sceneEmoji}} {{scene}}</text></nav-bar>
<view class="wrap">
  <view class="photo card" wx:if="{{photo}}" style="aspect-ratio: {{aspect}}">
    <image src="{{photo}}" mode="aspectFit" class="img" bindtap="tapPhoto" />
    <view wx:if="{{scanning}}" class="scan"></view>
    <view wx:for="{{objects}}" wx:key="id" class="stk {{item.zh === sel ? 'on' : ''}}" data-zh="{{item.zh}}" catchtap="learn"
      style="left: {{(item.box[0] + item.box[2]) / 20}}%; top: {{item.top}}%; --r: {{item.rot}}deg; animation-delay: {{index * 0.1}}s">
      <view class="brush stk-zh">{{item.zh}}</view><view class="stk-py">{{item.pinyin}}</view>
    </view>
    <view wx:if="{{pending}}" class="pin" style="left: {{pending.x}}%; top: {{pending.y}}%"></view>
  </view>

  <view class="card empty" wx:else>
    <image class="deer big-deer" src="/assets/deer.svg" mode="aspectFit" />
    <view class="cute" style="font-size: 40rpx">拍下孩子眼前的东西</view>
    <view class="hint">冰箱、书桌、玩具筐、菜篮子都可以</view>
    <view class="btn y" style="margin-top: 12rpx" bindtap="demo">先看一个示例：冰箱</view>
  </view>

  <view class="card pad found" wx:if="{{objects.length}}">
    <view class="between"><text class="title">找到 {{objects.length}} 样东西 ✦</text><text class="hint">{{cost}}</text></view>
    <view class="chips"><view wx:for="{{objects}}" wx:key="id" class="pill brush chip {{item.zh === sel ? 'o' : ''}}" data-zh="{{item.zh}}" bindtap="learn">{{item.zh}}</view></view>
    <view class="between" style="margin-top: 8rpx">
      <text class="hint">{{added ? '已全部加入复习' : '学过的词会自动进入复习'}}</text>
      <view class="btn sm w" bindtap="addAll">{{added ? '✓ 已加入' : '全部加入复习'}}</view>
    </view>
  </view>

  <view class="card pad manual" wx:if="{{photo && !aiOk}}">
    <view class="hint">{{pending ? '位置已记下，这个东西叫什么？' : '还没配看图模型：先点一下照片上的东西，再输入它的名字'}}</view>
    <view class="row" style="flex-wrap: nowrap">
      <input class="in" placeholder="比如：鸡蛋" value="{{manual}}" bindinput="onManual" confirm-type="done" bindconfirm="addManual" />
      <view class="btn sm" bindtap="addManual">贴上去</view>
    </view>
  </view>

  <view class="tipline" wx:if="{{status}}">
    <image class="deer" src="/assets/deer.svg" mode="aspectFit" />
    <view class="bubble" style="flex: 1">{{status}}</view>
  </view>

  <view class="controls">
    <view class="btn w side" bindtap="album">🖼️ 相册</view>
    <view class="shutter" bindtap="camera">📷</view>
    <view class="btn side {{storyReady ? 'y' : 'w'}}" bindtap="openStory">{{storyReady ? '📖 小故事' : storyLoading ? '✏️ 编故事…' : '📖 小故事'}}</view>
  </view>
  <canvas type="2d" id="work" class="offstage"></canvas>
</view>
