.topbar { display: flex; justify-content: space-between; align-items: flex-end; }
.inrow { display: flex; gap: 16rpx; align-items: center; }
.charin { width: 140rpx; height: 110rpx; font-size: 64rpx; text-align: center; font-weight: 600; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; border: 1rpx solid var(--line); border-radius: 12rpx; font-size: 32rpx; font-weight: 600; }
.chip.on { background: var(--accent); color: #fff; border-color: var(--accent); }
.opts { margin-top: 24rpx; display: flex; flex-direction: column; gap: 18rpx; }
.themes { display: flex; gap: 14rpx; }
.sw { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; font-size: 22rpx; padding: 10rpx 0; border: 1rpx solid var(--line); border-radius: 14rpx; }
.sw.on { border-color: var(--accent); box-shadow: inset 0 0 0 1rpx var(--accent); }
.dot { width: 44rpx; height: 44rpx; border-radius: 50%; }
.stage { margin-top: 24rpx; background: var(--sunk); border-radius: 20rpx; padding: 24rpx; }
.poster { width: 100%; display: block; border-radius: 8rpx; box-shadow: 0 20rpx 50rpx -24rpx rgba(0,0,0,.4); }
.tabs { display: flex; gap: 36rpx; border-bottom: 1rpx solid var(--line); margin-bottom: 20rpx; }
.tabs view { padding-bottom: 14rpx; color: var(--muted); }
.tabs .on { color: var(--ink); font-weight: 600; border-bottom: 4rpx solid var(--accent); }
.word { display: grid; grid-template-columns: 76rpx 150rpx 1fr 60rpx; grid-template-rows: auto auto; column-gap: 12rpx; padding: 14rpx 0; border-top: 1rpx solid var(--line); align-items: center; }
.word .cat { grid-row: span 2; font-size: 22rpx; text-align: center; background: var(--sunk); color: var(--muted); border-radius: 8rpx; padding: 4rpx 0; }
.word .cat.C { background: var(--accent-soft); color: var(--accent); }
.word .w { font-size: 34rpx; font-weight: 600; grid-row: span 2; }
.word .py { font-size: 26rpx; }
.word .en { font-size: 24rpx; color: var(--muted); grid-column: 3; }
.word .em { grid-column: 4; grid-row: 1 / span 2; grid-row-start: 1; font-size: 40rpx; text-align: center; }
.prompt { font-family: Menlo, monospace; font-size: 22rpx; white-space: pre-wrap; background: var(--sunk); border-radius: 14rpx; padding: 20rpx; }
.auto { font-size: 24rpx; padding: 10rpx 16rpx; background: var(--sunk); border-radius: 10rpx; margin-bottom: 8rpx; }
.auto.error { color: var(--cinnabar); } .auto.warn { color: #A86A12; }
.check { border-top: 1rpx solid var(--line); padding: 18rpx 0; }
.ct { font-weight: 600; }
.fix { background: var(--sunk); border-radius: 14rpx; padding: 18rpx; margin-top: 12rpx; font-size: 24rpx; }
