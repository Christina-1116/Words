.ctl { display: flex; gap: 18rpx; align-items: center; }
.charin { width: 124rpx; height: 124rpx; flex-shrink: 0; border: 5rpx solid var(--ink); border-radius: 32rpx; background: var(--card); font-size: 84rpx; text-align: center; box-shadow: 6rpx 6rpx 0 var(--ink); box-sizing: border-box; }
.chips { flex: 1; white-space: nowrap; }
.ch { display: inline-flex; width: 68rpx; height: 68rpx; margin-right: 12rpx; border: 4rpx solid var(--ink); border-radius: 20rpx; background: var(--card); align-items: center; justify-content: center; font-size: 40rpx; box-sizing: border-box; }
.ch.on { background: var(--persimmon); color: #fff; }
.poster { overflow: hidden; padding: 0; } .pc { width: 100%; display: block; }
.qc { padding: 20rpx 24rpx; display: flex; align-items: center; gap: 16rpx; } .qt { flex: 1; font-size: 26rpx; }
.two { display: flex; gap: 20rpx; } .two .btn { flex: 1; }
.tabs { display: flex; gap: 32rpx; margin-bottom: 16rpx; border-bottom: 3rpx dashed var(--line); }
.tab { padding-bottom: 12rpx; color: var(--sub); font-size: 30rpx; } .tab.on { color: var(--ink); border-bottom: 6rpx solid var(--persimmon); }
.word { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; border-top: 3rpx dashed var(--line); }
.cat { width: 72rpx; font-size: 22rpx; text-align: center; border: 3rpx solid var(--ink); border-radius: 12rpx; padding: 2rpx 0; background: var(--card); flex-shrink: 0; }
.cat.B { background: var(--sky); } .cat.L { background: var(--sage); } .cat.A { background: var(--mustard); } .cat.C { background: var(--persimmon); color: #fff; }
.wm { display: flex; flex-direction: column; width: 200rpx; } .ww { font-size: 38rpx; line-height: 1.2; } .wm .py { font-size: 22rpx; }
.we { flex: 1; font-size: 24rpx; color: var(--sub); } .em { font-size: 44rpx; }
.prompt { font-family: Menlo, monospace; font-size: 22rpx; white-space: pre-wrap; background: var(--paper); border: 3rpx dashed var(--line); border-radius: 20rpx; padding: 20rpx; }
.auto { font-size: 24rpx; padding: 10rpx 16rpx; background: var(--paper); border-radius: 14rpx; margin-bottom: 8rpx; }
.auto.error { color: var(--cinnabar); } .auto.warn { color: #A86A12; }
.check { border-top: 3rpx dashed var(--line); padding: 18rpx 0; } .ct { font-weight: 600; }
.fix { background: var(--paper); border-radius: 20rpx; padding: 18rpx; margin-top: 12rpx; font-size: 24rpx; }
