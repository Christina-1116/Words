<nav-bar title="模型设置" back="{{true}}"></nav-bar>
<view class="wrap notab">
  <view class="card pad st">
    <image class="deer" src="/assets/deer.svg" mode="aspectFit" />
    <view style="flex: 1">
      <view class="title">现在能用的</view>
      <view class="li"><text class="pill {{can.text ? 's' : ''}}">{{can.text ? '✓' : '✗'}} 文字</text><text class="hint">字族策划、小故事{{can.textModel ? ' · ' + can.textModel : ''}}</text></view>
      <view class="li"><text class="pill {{can.vision ? 's' : ''}}">{{can.vision ? '✓' : '✗'}} 看图</text><text class="hint">{{can.vision ? '拍照自动识别' : '未配置，拍照用手动贴字'}}</text></view>
    </view>
  </view>

  <view class="card pad form">
    <view class="title">调用方式</view>
    <view class="row"><text class="pill {{s.mode === 'cloud' ? 'o' : ''}}" data-v="cloud" bindtap="setMode">云函数代理（推荐）</text><text class="pill {{s.mode === 'direct' ? 'o' : ''}}" data-v="direct" bindtap="setMode">直连（调试）</text></view>
    <view class="hint" wx:if="{{s.mode === 'cloud'}}">Key 配在云函数 aiProxy 里：文字任务用 TEXT_KEY（DeepSeek），拍照识别用 VISION_KEY（通义千问 VL）。上线必须用这种方式。</view>
    <block wx:else>
      <view class="hint">只在开发者工具里调试用，要先把接口域名加进 request 合法域名。</view>
      <view class="lb">服务商</view>
      <picker range="{{presetNames}}" value="{{presetIndex}}" bindchange="setPreset"><view class="in">{{presetNames[presetIndex]}} ▾</view></picker>
      <view class="lb">接口地址</view><input class="in" value="{{s.base}}" data-k="base" bindinput="edit" />
      <view class="lb">模型</view><input class="in" value="{{s.model}}" data-k="model" bindinput="edit" />
      <view class="lb">API Key</view><input class="in" password="{{true}}" value="{{s.key}}" data-k="key" bindinput="edit" />
    </block>
    <view class="btn" style="margin-top: 12rpx" bindtap="save">保存</view>
  </view>
</view>
